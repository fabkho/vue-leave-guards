{
  "name": "vue-leave-guards",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.21.0",
  "description": "Nested unsaved-changes guards for Vue 3: scopes that nest, so a dirty form inside a modal inside a drawer collapses into one route guard and one beforeunload.",
  "author": "Fabian Kirchhoff",
  "license": "MIT",
  "homepage": "https://github.com/fabkho/vue-leave-guards#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabkho/vue-leave-guards.git"
  },
  "bugs": {
    "url": "https://github.com/fabkho/vue-leave-guards/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "composable",
    "unsaved-changes",
    "dirty-form",
    "leave-guard",
    "navigation-guard",
    "beforeunload",
    "vue-router",
    "confirm"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "vite build",
    "check:dts": "node scripts/check-dts.mjs",
    "dev": "pnpm -C playground dev",
    "build:playground": "pnpm --filter playground build && node scripts/verify-playground.mjs",
    "demo:shoot": "node scripts/shoot-demo.mjs",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.10",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.0.0",
    "husky": "^9.1.7",
    "playwright": "^1.50.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^3.3.10"
  }
}
